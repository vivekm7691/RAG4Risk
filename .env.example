# RAG4Risk Environment Variables
# Copy this file to .env and update with your values.
# The FastAPI app loads .env from the current working directory (often backend/ when using uvicorn there).

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
# httpx timeout (seconds) for RAG Ollama /api/generate (streaming and non-streaming)
OLLAMA_TIMEOUT=3000.0
# Ollama options.num_ctx for RAG /api/generate and intent /api/chat (e.g. 16384 for DeepSeek-R1 + long context). Set 0 to use server default.
OLLAMA_NUM_CTX=16384

# ============================================
# Embedding Model Configuration
# ============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# Qdrant (backend vector store — current)
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag4risk_documents
# Higher = better recall for filtered ANN; set 0 to omit custom search params
QDRANT_SEARCH_HNSW_EF=128

# Legacy Chroma names (ignored by app; kept for older compose/docs)
# CHROMA_HOST=chroma
# CHROMA_PORT=8000
# CHROMA_COLLECTION_NAME=rag4risk_documents

# ============================================
# Document Chunking Configuration
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# ============================================
# Phase 3.75: Query intent (per-type retrieval weights via Ollama /api/chat)
# ============================================
# When false, the API ignores use_query_intent on requests (no intent LLM call).
QUERY_INTENT_ENABLED=true
# Optional: separate Ollama base URL for the intent model; empty uses OLLAMA_BASE_URL
# INTENT_LLM_BASE_URL=http://localhost:11434
INTENT_LLM_MODEL=deepseek-r1
# HTTP timeout for intent call (seconds). Alias: INTENT_LLM_TIMEOUT
INTENT_LLM_TIMEOUT_SECONDS=600
# Max tokens for intent reply (reasoning models need ~4096 for thinking + JSON)
INTENT_LLM_MAX_TOKENS=4096
INTENT_LLM_TEMPERATURE=0.1

# Phase 3.5: past projects (optional tuning)
# PROJECT_SIMILARITY_CACHE_TTL_SECONDS=300
# PROJECT_SIMILARITY_META_WEIGHT_CSG_PRODUCTS=0.20
# PROJECT_SIMILARITY_META_WEIGHT_INTEGRATION_COMPLEXITY=0.15
# PROJECT_SIMILARITY_META_WEIGHT_PROJECT_SIZE=0.10
# PROJECT_SIMILARITY_META_WEIGHT_PROJECT_COMPLEXITY=0.15
# PROJECT_SIMILARITY_META_WEIGHT_CSG_ROLE=0.15
# PROJECT_SIMILARITY_META_WEIGHT_CLIENT_TYPE=0.15
# PROJECT_SIMILARITY_META_WEIGHT_DATE_RANGE=0.10

# ============================================
# API Configuration
# ============================================
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Frontend Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# Knowledge graph (Neo4j) — Phase 1
# ============================================
# Set true to enable graph storage and future graph-augmented retrieval
GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rag4risk-dev
NEO4J_DATABASE=neo4j
# GRAPH_NEIGHBORHOOD_DEFAULT_DEPTH=2
# GRAPH_NEIGHBORHOOD_DEFAULT_LIMIT=50
# GRAPH_MAX_DEPTH=3
# GRAPH_QUERY_TIMEOUT_SECONDS=10.0
# Phase 4: graph retrieval guardrails
# GRAPH_MAX_DEGREE_PER_SEED=25
# GRAPH_MAX_SEEDS=10
# GRAPH_CONNECTION_CHECK_TTL_SECONDS=30.0
# Phase 5: graph retrieval evaluation (offline) — run: python run_graph_eval.py
# Default eval set: backend/eval/graph_eval_set.json
# Phase 3: graph-augmented retrieval (use_graph_augmentation on query API)
# GRAPH_RETRIEVAL_EXTRA_BUDGET=5
# Phase 5.1: merge + text-search seeds
# GRAPH_MERGE_STRATEGY=append
# GRAPH_TEXT_SEARCH_SEED_ENABLED=false
# GRAPH_TEXT_SEARCH_SEED_LIMIT=10
# Phase 2: LLM relation extraction on Word ingest
# GRAPH_EXTRACT_ON_INGEST=true
# GRAPH_EXTRACT_MAX_CHUNKS=20
# GRAPH_EXTRACT_TIMEOUT_SECONDS=120.0
# Phase 5.2: SOW ↔ solution cross-artifact linking
# GRAPH_CROSS_LINK_ENABLED=false
# GRAPH_CROSS_LINK_ON_INGEST=false
# GRAPH_CROSS_LINK_MIN_CONFIDENCE=0.80
# GRAPH_CROSS_LINK_MAX_DEPTH=3
# GRAPH_CROSS_LINK_EDGE_WHITELIST=IMPLEMENTS,ADDRESSES,TRACES_TO,SAME_AS,DESCRIBES_CURRENT_STATE_OF,GAPS
# GRAPH_CROSS_LINK_MAX_EDGES_PER_SOURCE=5
