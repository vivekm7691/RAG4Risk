# RAG4Risk Environment Variables
# Copy this file to .env and update with your values

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ============================================
# Embedding Model Configuration
# ============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# Chroma Vector Database Configuration
# ============================================
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=rag4risk_documents

# ============================================
# Document Chunking Configuration
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Phase 3.5: past projects (optional tuning)
# PROJECT_SIMILARITY_CACHE_TTL_SECONDS=300
# PROJECT_SIMILARITY_META_WEIGHT_CSG_PRODUCTS=0.20
# PROJECT_SIMILARITY_META_WEIGHT_INTEGRATION_COMPLEXITY=0.15
# PROJECT_SIMILARITY_META_WEIGHT_PROJECT_SIZE=0.10
# PROJECT_SIMILARITY_META_WEIGHT_PROJECT_COMPLEXITY=0.15
# PROJECT_SIMILARITY_META_WEIGHT_CSG_ROLE=0.15
# PROJECT_SIMILARITY_META_WEIGHT_CLIENT_TYPE=0.15
# PROJECT_SIMILARITY_META_WEIGHT_DATE_RANGE=0.10

# ============================================
# API Configuration
# ============================================
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Frontend Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:8000
